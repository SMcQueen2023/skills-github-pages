---
import Base from '../../layouts/Base.astro';
import { standaloneProjects, type StandaloneProject } from '../../data/standaloneProjects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredSlugs = ['finance-analytics-platform', 'parqcel', 'consultation-workflow-automation'];
const featured = featuredSlugs.map((slug) => standaloneProjects.find((project) => project.slug === slug)!);
const moreProjects = standaloneProjects.filter((project) => !featuredSlugs.includes(project.slug));
const href = (project: StandaloneProject) => `${base}/projects/${project.slug}/`;
---

<Base title="Independent engineering projects — Scott McQueen" description="Inspect Scott McQueen’s SQL models, data-quality tests, Python transformations, and workflow automation. Independent projects and academic work, clearly labeled." current="projects">
  <header class="project-lead wrap">
    <p class="eyebrow">Independent projects & academic work</p>
    <h1>Inspect the implementation.</h1>
    <p class="intro">SQL models, data-quality checks, desktop data tools, and workflow automation. These projects show how I build and validate outside my employment roles.</p>
    <a class="action-link" href={`${base}/work/`}>View professional delivery cases <span aria-hidden="true">↗</span></a>
  </header>
  <section class="technical-band" aria-labelledby="technical-heading">
    <div class="wrap">
      <div class="section-intro"><p class="eyebrow">Start with the source</p><h2 id="technical-heading">Technical evidence you can open.</h2></div>
      <div class="technical-grid">
        {featured.map((project) => <article class="technical-card">
          <div class="project-meta"><span>{project.kind}</span><span>{project.status}</span></div>
          <h3><a href={href(project)}>{project.title}</a></h3>
          <p>{project.summary}</p>
          <div class="artifact-preview"><span class="mono">Inspect</span><p>{project.artifacts?.slice(0, 2).map((artifact) => artifact.title).join(' · ')}</p></div>
          <a class="case-link" href={`${href(project)}#artifacts`}>Open case & source files <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>
  <section class="more-projects wrap" aria-labelledby="more-heading">
    <div class="section-intro"><p class="eyebrow">Further projects</p><h2 id="more-heading">Products, experiments, and analysis.</h2></div>
    <div class="project-list">
      {moreProjects.map((project) => <article class="project-row">
        <div><div class="project-meta"><span>{project.kind}</span><span>{project.status}</span></div><h3><a href={href(project)}>{project.title}</a></h3></div>
        <div><p>{project.summary}</p><a class="case-link" href={href(project)}>Read project <span aria-hidden="true">↗</span></a></div>
      </article>)}
    </div>
  </section>
</Base>

<style>
  .project-lead{padding-block:clamp(3rem,6vw,5rem)}
  .project-lead h1{font-size:clamp(2.8rem,6vw,5.4rem);letter-spacing:-.065em;max-width:17ch;margin:1rem 0 1.5rem;line-height:1.02}
  .intro{max-width:48rem;font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.5}
  .project-lead .action-link{margin-top:1.75rem}
  .technical-band{background:var(--ink);color:var(--paper-light);padding-block:clamp(3rem,5vw,5rem)}
  .section-intro{display:grid;grid-template-columns:.5fr 1fr;gap:2rem;border-top:1px solid var(--rule);padding-top:1rem;margin-bottom:2rem}
  .section-intro h2{font-size:clamp(2rem,3.6vw,3.4rem);letter-spacing:-.045em;max-width:22ch;line-height:1.08}
  .technical-band .eyebrow{color:var(--signal-bright)}
  .technical-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
  .technical-card{display:flex;flex-direction:column;border-top:2px solid var(--signal-bright);padding:1.3rem 0}
  .project-meta{display:flex;flex-direction:column;gap:.35rem;font-family:var(--font-mono);font-size:.7rem;letter-spacing:.035em;line-height:1.55;text-transform:uppercase;color:var(--muted)}
  .technical-card .project-meta{color:#b8cbd1;min-height:3.4rem}
  .technical-card h3{font-size:clamp(1.7rem,2.5vw,2.6rem);letter-spacing:-.045em;margin:1.1rem 0;line-height:1.08}
  .technical-card h3 a:hover{color:var(--signal-bright);text-decoration:underline;text-underline-offset:.15em}
  .technical-card>p{color:#d1dfe3;font-size:1rem;line-height:1.55}
  .artifact-preview{border-top:1px solid #56717c;margin-top:1.5rem;padding-top:1rem}
  .artifact-preview .mono{color:var(--signal-bright)}
  .artifact-preview p{color:#b8cbd1;margin:.5rem 0 1.5rem;font-size:.9rem}
  .case-link{display:inline-flex;align-items:center;gap:1rem;font-size:.92rem;font-weight:600;text-decoration:underline;text-underline-offset:.25em;width:fit-content;padding-block:.6rem}
  .technical-card>.case-link{margin-top:auto;color:var(--paper-light)}
  .technical-card>.case-link:hover{color:var(--signal-bright)}
  .more-projects{padding-block:clamp(3rem,5vw,5rem)}
  .project-row{display:grid;grid-template-columns:1fr 1fr;gap:3rem;border-top:1px solid var(--rule);padding-block:1.75rem}
  .project-row h3{font-size:clamp(1.6rem,2.6vw,2.5rem);letter-spacing:-.045em;line-height:1.1;max-width:25ch;margin-top:.8rem}
  .project-row h3 a:hover{text-decoration:underline;text-underline-offset:.15em}
  .project-row p{color:var(--muted);line-height:1.6}
  .project-row .case-link{margin-top:.7rem}
  @media(max-width:900px){.technical-grid{grid-template-columns:1fr}.technical-card .project-meta{min-height:0;flex-direction:row;flex-wrap:wrap;gap:.4rem 1rem}.artifact-preview p{margin-bottom:.5rem}.technical-card h3{max-width:none}}
  @media(max-width:600px){.section-intro,.project-row{grid-template-columns:1fr;gap:1rem}.project-lead h1{font-size:clamp(2.6rem,11vw,4rem)}.technical-card h3{font-size:2rem}}
</style>
