---
import Base from '../../layouts/Base.astro';
import { standaloneProjects, type StandaloneProject } from '../../data/standaloneProjects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [flagship, ...moreProjects] = standaloneProjects;
const href = (project: StandaloneProject) => `${base}/projects/${project.slug}/`;
---

<Base
  title="Projects — Scott McQueen"
  description="Independent products and technical projects by Scott McQueen, led by Everything is Random."
  current="projects"
>
  <div class="project-index">
    <header class="index-cover wrap">
      <div class="index-kicker"><span>Independent projects</span><span>01 — {String(standaloneProjects.length).padStart(2, '0')}</span></div>
      <h1>What I’ve made <em>beyond my roles.</em></h1>
      <div class="index-intro">
        <p>This collection spans a launched browser product, desktop software, workflow automation, a data warehouse slice, technical publishing, and applied academic analysis.</p>
        <p class="mono">Product thinking<br />Engineering decisions<br />Working software</p>
      </div>
    </header>

    <section class="flagship-band" aria-labelledby="flagship-heading">
      <div class="wrap">
        <div class="section-rail"><span>01 / Flagship project</span><span>{flagship.status}</span></div>
        <div class="flagship-grid">
          <div class="flagship-copy">
            <p class="eyebrow">{flagship.kind}</p>
            <h2 id="flagship-heading">{flagship.title}<span class="period">.</span></h2>
            <p class="flagship-headline">{flagship.headline}</p>
            <p class="flagship-summary">{flagship.summary}</p>
            <div class="flagship-actions">
              <a href={href(flagship)}>Read the project case <span aria-hidden="true">↗</span></a>
              {flagship.liveUrl && <a href={flagship.liveUrl} target="_blank" rel="noopener noreferrer">Open the live site <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
          <div class="system-portrait" role="img" aria-label="Sample of four Everything is Random tools: Dice, Words, UUID, and Teams">
            <div class="portrait-top"><span>Everything is Random / four example tools</span><span>001</span></div>
            <div class="portrait-orbit" aria-hidden="true"><span class="orbit-center">?</span><span class="orbit-label orbit-one">DICE</span><span class="orbit-label orbit-two">WORDS</span><span class="orbit-label orbit-three">UUID</span><span class="orbit-label orbit-four">TEAMS</span></div>
            <div class="portrait-base"><span>Choose a tool</span><span>→</span><span>Generate</span><span>→</span><span>Use the result</span></div>
          </div>
        </div>
        <div class="flagship-highlights">
          {flagship.highlights.slice(0, 3).map((item, index) => <div><span>{String(index + 1).padStart(2, '0')} / {item.label}</span><p>{item.detail}</p></div>)}
        </div>
      </div>
    </section>

    <section class="project-list wrap" aria-labelledby="more-projects-heading">
      <div class="list-head"><p class="eyebrow">02 / More projects</p><h2 id="more-projects-heading">Other things I’ve made.</h2></div>
      <div class="list-items">
        {moreProjects.map((project, index) => <article class="project-row">
          <span class="row-number">{String(index + 2).padStart(2, '0')}</span>
          <div class="row-main"><div class="row-meta"><span>{project.kind}</span><span>{project.status}</span></div><h3><a href={href(project)}>{project.title}</a></h3><p>{project.summary}</p></div>
          <a class="row-arrow" href={href(project)} aria-label={`Read the ${project.title} project case`}>↗</a>
        </article>)}
      </div>
    </section>
  </div>
</Base>

<style>
  .project-index{overflow:hidden}
  .index-cover{padding-block:clamp(3.5rem,7vw,7rem) clamp(4.5rem,8vw,8rem)}
  .index-kicker,.section-rail,.row-meta,.row-number,.portrait-top,.portrait-base,.flagship-highlights span{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase}
  .index-kicker,.section-rail{display:flex;justify-content:space-between;gap:1rem;border-top:2px solid currentColor;padding-top:.8rem}
  .index-cover h1{font-size:clamp(3.7rem,9vw,9.5rem);line-height:.88;letter-spacing:-.085em;max-width:13ch;margin:3rem 0 3.5rem}
  .index-cover h1 em{color:var(--signal);font-style:normal}
  .index-intro{display:grid;grid-template-columns:minmax(0,1fr) 13rem;gap:3rem;border-top:1px solid var(--ink);padding-top:1.2rem}
  .index-intro>p:first-child{font-size:clamp(1.25rem,2vw,1.9rem);line-height:1.3;max-width:47rem}
  .index-intro .mono{color:var(--muted);line-height:1.65;border-left:1px solid var(--rule);padding-left:1.25rem}
  .flagship-band{background:var(--ink);color:var(--paper-light);padding-block:clamp(3rem,5vw,5rem) clamp(4rem,7vw,7rem)}
  .section-rail{color:var(--signal-bright);border-color:#56717c}
  .flagship-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,6rem);padding-block:clamp(3rem,6vw,6rem)}
  .flagship-copy{display:flex;flex-direction:column;align-items:start}
  .flagship-copy .eyebrow{color:var(--signal-bright)}
  .flagship-copy h2{font-size:clamp(4rem,7vw,8rem);line-height:.88;letter-spacing:-.08em;max-width:11ch;margin:2rem 0}
  .period{color:var(--signal-bright)}
  .flagship-headline{font-family:var(--font-display);font-size:clamp(1.6rem,2.5vw,2.6rem);font-weight:600;line-height:1.1;letter-spacing:-.045em;max-width:23ch}
  .flagship-summary{color:#b8cbd1;font-size:1.05rem;line-height:1.45;max-width:38rem;margin:1.4rem 0 2.4rem}
  .flagship-actions{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:auto}
  .flagship-actions a{display:inline-flex;justify-content:space-between;gap:2rem;border-bottom:2px solid var(--signal-bright);padding:.5rem 0;color:#fff;font-family:var(--font-mono);font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
  .flagship-actions a:hover{color:var(--signal-bright)}
  .system-portrait{min-height:29rem;display:flex;flex-direction:column;border:1px solid #55717c;background:radial-gradient(circle at 50% 52%,#183b46 0,#11252f 38%,#0c1722 72%);position:relative;overflow:hidden}
  .system-portrait::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#6fa0a518 1px,transparent 1px),linear-gradient(90deg,#6fa0a518 1px,transparent 1px);background-size:34px 34px}
  .portrait-top,.portrait-base{z-index:1;display:flex;justify-content:space-between;gap:.6rem;padding:1rem;color:#b8ced4}
  .portrait-top{border-bottom:1px solid #55717c}
  .portrait-base{margin-top:auto;border-top:1px solid #55717c;color:#e9fafa}
  .portrait-base span:nth-child(even){color:var(--signal-bright)}
  .portrait-orbit{z-index:1;width:min(70%,19rem);aspect-ratio:1;margin:auto;border:1px solid #68b8be88;border-radius:50%;display:grid;place-items:center;position:relative;box-shadow:0 0 0 3rem #49d6d00a,0 0 0 6rem #49d6d006}
  .portrait-orbit::before,.portrait-orbit::after{content:'';position:absolute;inset:17%;border:1px dashed #68b8be88;border-radius:50%}.portrait-orbit::after{inset:37%;border:1px solid var(--signal-bright);background:#0c1722}
  .orbit-center{z-index:2;color:var(--signal-bright);font-family:var(--font-display);font-size:4rem;line-height:1}
  .orbit-label{position:absolute;z-index:2;background:#0c1722;border:1px solid #68b8be;padding:.3rem .5rem;color:#dffbfa;font-family:var(--font-mono);font-size:.67rem;letter-spacing:.06em}
  .orbit-one{top:0;left:13%}.orbit-two{right:-8%;top:33%}.orbit-three{bottom:5%;right:4%}.orbit-four{bottom:18%;left:-9%}
  .flagship-highlights{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #55717c}
  .flagship-highlights>div{padding:1.2rem 1.2rem 0 0}.flagship-highlights>div+div{border-left:1px solid #55717c;padding-left:1.2rem}
  .flagship-highlights span{color:var(--signal-bright)}.flagship-highlights p{margin-top:.9rem;font-size:1.05rem;line-height:1.4;max-width:25rem}
  .project-list{padding-block:clamp(5rem,8vw,9rem)}
  .list-head{border-top:2px solid var(--ink);padding-top:.8rem;margin-bottom:3rem}
  .list-head h2{font-size:clamp(3rem,5.8vw,6rem);letter-spacing:-.07em;line-height:.95;max-width:15ch;margin:1.5rem 0 0}
  .project-row{display:grid;grid-template-columns:5rem 1fr 2rem;gap:1rem;border-top:1px solid var(--ink);padding:1.5rem 0 2rem}
  .project-row:last-child{border-bottom:1px solid var(--ink)}
  .row-number{color:var(--signal);font-size:1rem}.row-meta{display:flex;gap:1rem;justify-content:space-between;color:var(--muted)}
  .row-main h3{font-size:clamp(2.5rem,4vw,4.5rem);letter-spacing:-.065em;line-height:.95;margin:.75rem 0;max-width:22ch}.row-main h3 a:hover{text-decoration:underline;text-decoration-color:var(--signal);text-underline-offset:.1em}
  .row-main>p{color:var(--muted);font-size:1.03rem;line-height:1.45;max-width:45rem}
  .row-arrow{font-size:2rem;line-height:1;color:var(--signal)}
  @media(max-width:900px){.flagship-grid{grid-template-columns:1fr}.system-portrait{min-height:24rem}.flagship-copy h2{max-width:18ch}}
  @media(max-width:600px){.index-cover h1{font-size:clamp(3.25rem,12vw,5rem);margin:2.5rem 0}.index-intro{grid-template-columns:1fr;gap:1.2rem}.index-intro .mono{border-left:0;border-top:1px solid var(--rule);padding:1rem 0 0}.flagship-copy h2{font-size:clamp(3.6rem,14vw,5.8rem)}.portrait-base{font-size:.55rem}.flagship-highlights{grid-template-columns:1fr}.flagship-highlights>div,.flagship-highlights>div+div{border-left:0;border-bottom:1px solid #55717c;padding:1rem 0}.project-row{grid-template-columns:2rem 1fr 1.2rem;gap:.6rem}.row-main h3{font-size:2.25rem}.row-meta{flex-direction:column;gap:.15rem}.row-arrow{font-size:1.4rem}}
</style>
