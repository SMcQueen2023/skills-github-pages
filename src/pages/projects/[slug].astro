---
import Base from '../../layouts/Base.astro';
import { standaloneProjects, type StandaloneProject } from '../../data/standaloneProjects';

export function getStaticPaths() {
  const movedWorkSlugs = [
    'reporting-modernization',
    'reconciliation-automation',
    'portfolio-governance-platform',
    'sas-to-azure-migration',
    'enterprise-data-modeling',
    'external-analytics-enablement',
  ];
  return [
    ...standaloneProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })),
    ...movedWorkSlugs.map((redirectSlug) => ({ params: { slug: redirectSlug }, props: { redirectSlug } })),
  ];
}

const { project, redirectSlug } = Astro.props as { project?: StandaloneProject; redirectSlug?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const workDestination = redirectSlug ? `${base}/work/${redirectSlug}/` : '';
const index = project ? standaloneProjects.findIndex((entry) => entry.slug === project.slug) : -1;
const next = index >= 0 ? standaloneProjects[(index + 1) % standaloneProjects.length] : undefined;
const isFlagship = index === 0;
const hasExternalLink = Boolean(project?.liveUrl || project?.sourceUrl);
---

{redirectSlug ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta http-equiv="refresh" content={`0; url=${workDestination}`} />
      <link rel="canonical" href={new URL(workDestination, Astro.site ?? 'https://smcqueen2023.github.io').href} />
      <meta property="og:image" content={new URL(`${base}/assets/social/decision-file.png`, Astro.site ?? 'https://smcqueen2023.github.io').href} />
      <title>Work case moved — Scott McQueen</title>
      <style is:global>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f2f6f7;color:#0c1722;font:1.1rem Arial,sans-serif}main{max-width:38rem;padding:2rem}h1{font-size:2.5rem;line-height:1}a{color:#0b707c;text-underline-offset:.2em}</style>
    </head>
    <body><main><h1>This work case has moved.</h1><p>Continue to the <a href={workDestination}>updated professional work case</a>.</p></main></body>
  </html>
) : project && (
  <Base title={`${project.title} — Projects — Scott McQueen`} description={project.summary} current="projects">
    <article class:list={['standalone-case', isFlagship && 'flagship-case']}>
      <header class="case-intro wrap">
        <div class="case-rail"><a href={`${base}/projects/`}>← All projects</a><span>{String(index + 1).padStart(2, '0')} / {String(standaloneProjects.length).padStart(2, '0')}</span><span>{project.kind}</span></div>
        <div class="case-title-block"><div><p class="eyebrow">{project.status} / Project case</p><h1>{project.title}<span>.</span></h1><p class="case-headline">{project.headline}</p></div>{isFlagship && <div class="case-orbit" aria-hidden="true"><span class="orbit-ring orbit-outer"></span><span class="orbit-ring orbit-inner"></span><strong>?</strong><span class="orbit-tag tag-one">DICE</span><span class="orbit-tag tag-two">UUID</span><span class="orbit-tag tag-three">WORDS</span><span class="orbit-tag tag-four">TEAMS</span><span class="orbit-note">EXAMPLE TOOLS / WEB CRYPTO</span></div>}</div>
        <div class:list={['case-deck', !hasExternalLink && 'case-deck-solo']}><p>{project.summary}</p>{hasExternalLink && <div class="case-actions">{project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">Open the project <span aria-hidden="true">↗</span></a>}{project.sourceUrl && <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a>}</div>}</div>
      </header>

      <section class="system-section" aria-labelledby="system-heading">
        <div class="wrap">
          <div class="system-head"><p class="eyebrow">01 / Under the hood</p><h2 id="system-heading">Key design choices.</h2><p>Selected decisions from the public project record.</p></div>
          <div class="system-steps" style={`--step-count:${project.highlights.length}`}>
            {project.highlights.map((item, step) => <div class="system-step"><span class="step-index">{String(step + 1).padStart(2, '0')}</span><div><h3>{item.label}</h3><p>{item.detail}</p></div><span class="step-marker" aria-hidden="true">{step === project.highlights.length - 1 ? '■' : '→'}</span></div>)}
          </div>
          <div class="system-foot"><span>Tools and methods</span><p>{project.stack.join(' / ')}</p></div>
        </div>
      </section>

      <section class="case-story wrap" aria-label="Project case study">
        <div class="story-intro"><p class="eyebrow">02 / The problem</p><h2>{project.question}</h2></div>
        <div class="story-records">
          <section><span class="story-number">01 / Approach</span><div><h3>{project.storyHeadings[0]}</h3><p>{project.approach}</p></div></section>
          <section><span class="story-number">02 / Engineering</span><div><h3>{project.storyHeadings[1]}</h3><p>{project.engineering}</p></div></section>
          <section><span class="story-number">03 / Verification</span><div><h3>{project.storyHeadings[2]}</h3><p>{project.verification}</p></div></section>
        </div>
      </section>

      <section class="outcome-band"><div class="wrap outcome-grid"><div><p class="eyebrow">03 / Delivered</p><h2>What came out of it.</h2></div><div><p class="outcome-text">{project.outcome}</p><div class="boundary"><span>Scope and limits</span><p>{project.boundary}</p></div></div></div></section>
      <nav class="case-next wrap" aria-label="Continue through projects"><a href={`${base}/projects/`}>← Projects index</a>{next && <a href={`${base}/projects/${next.slug}/`}><span>Next project</span><strong>{next.title}</strong><b aria-hidden="true">↗</b></a>}</nav>
    </article>
  </Base>
)}

<style>
  .standalone-case{overflow:hidden}
  .case-intro{padding-block:3rem clamp(4rem,8vw,8rem)}
  .case-rail,.case-actions a,.system-foot span,.system-step .step-index,.story-number,.boundary span,.case-next>a:last-child span{font-family:var(--font-mono);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}
  .case-rail{display:flex;justify-content:space-between;gap:1rem;border-top:2px solid var(--ink);padding-top:.7rem}
  .case-rail a{text-decoration:underline;text-underline-offset:.2em}
  .case-title-block{padding-block:clamp(3rem,6vw,6rem) clamp(2rem,4vw,4rem)}
  .case-title-block .eyebrow{color:var(--signal)}
  .case-title-block h1{font-size:clamp(4rem,9vw,10rem);letter-spacing:-.085em;line-height:.86;max-width:14ch;margin:1.5rem 0 2rem}
  .case-title-block h1 span{color:var(--signal)}
  .case-headline{font-family:var(--font-display);font-size:clamp(1.6rem,2.8vw,3rem);line-height:1.1;letter-spacing:-.05em;max-width:26ch}
  .flagship-case .case-title-block{display:grid;grid-template-columns:minmax(0,1fr) minmax(16rem,.48fr);gap:clamp(2rem,5vw,6rem);align-items:center}
  .case-orbit{width:100%;aspect-ratio:1;max-width:25rem;justify-self:end;position:relative;border:1px solid var(--rule);background:radial-gradient(circle at center,#d9ebed 0,#edf5f6 45%,transparent 70%);overflow:hidden}
  .case-orbit::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#96b8c126 1px,transparent 1px),linear-gradient(90deg,#96b8c126 1px,transparent 1px);background-size:28px 28px}
  .orbit-ring{position:absolute;top:50%;left:50%;width:69%;aspect-ratio:1;border:1px solid var(--signal);border-radius:50%;transform:translate(-50%,-50%)}
  .orbit-inner{width:30%;border-style:dashed}
  .case-orbit strong{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:var(--signal);font-family:var(--font-display);font-size:clamp(4rem,7vw,7rem);font-weight:500;line-height:1}
  .orbit-tag,.orbit-note{position:absolute;z-index:1;background:var(--ink);color:var(--paper-light);padding:.3rem .45rem;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.05em}
  .tag-one{top:18%;left:18%}.tag-two{top:29%;right:7%}.tag-three{bottom:21%;right:14%}.tag-four{bottom:27%;left:5%}.orbit-note{left:0;bottom:0;background:var(--signal);font-size:.6rem}
  .case-deck{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;border-top:1px solid var(--ink);padding-top:1.3rem;align-items:start}
  .case-deck-solo{grid-template-columns:1fr}
  .case-deck>p{font-size:clamp(1.1rem,1.7vw,1.55rem);line-height:1.4;max-width:52rem}
  .case-actions{display:flex;flex-direction:column;align-items:stretch;gap:.75rem;min-width:13rem}
  .case-actions a{display:flex;justify-content:space-between;gap:1rem;border-bottom:2px solid var(--ink);padding:.3rem 0 .6rem;font-weight:600}
  .case-actions a:hover{border-color:var(--signal)}
  .system-section{background:var(--ink);color:var(--paper-light);padding-block:clamp(4rem,6vw,7rem)}
  .system-section .eyebrow{color:var(--signal-bright)}
  .system-head{display:grid;grid-template-columns:.35fr 1fr .6fr;gap:2rem;align-items:end;border-top:1px solid #56717c;padding-top:.7rem;margin-bottom:clamp(2rem,4vw,4rem)}
  .system-head h2{font-size:clamp(2.8rem,5vw,5.7rem);line-height:.95;letter-spacing:-.07em;max-width:12ch}
  .system-head>p:last-child{color:#b8cbd1;font-size:.98rem;line-height:1.4;max-width:18rem}
  .system-steps{display:grid;grid-template-columns:repeat(var(--step-count),minmax(0,1fr));border-top:1px solid #56717c;border-bottom:1px solid #56717c}
  .system-step{position:relative;display:flex;flex-direction:column;min-height:19rem;padding:1.25rem 1.25rem 1.5rem;border-right:1px solid #56717c}
  .system-step:first-child{padding-left:0}.system-step:last-child{border-right:0}
  .system-step::before{content:'';position:absolute;top:-5px;left:-4px;width:8px;height:8px;background:var(--signal-bright);transform:rotate(45deg)}.system-step:first-child::before{left:0}
  .step-index,.step-marker{color:var(--signal-bright)}
  .system-step>div{margin-top:clamp(3rem,6vw,6rem)}.system-step h3{font-size:clamp(1.6rem,2.4vw,2.6rem);letter-spacing:-.055em;line-height:1.05;max-width:12ch}.system-step p{color:#b8cbd1;line-height:1.4;font-size:.92rem;margin-top:.8rem}
  .step-marker{font-size:1.3rem;line-height:1;margin-top:auto;padding-top:1rem}
  .system-foot{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;border-bottom:1px solid #56717c;padding:1rem 0}.system-foot span{color:var(--signal-bright)}.system-foot p{color:#b8cbd1}
  .case-story{padding-block:clamp(5rem,8vw,9rem)}
  .story-intro{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;margin-bottom:clamp(4rem,7vw,7rem)}
  .story-intro h2{font-size:clamp(2.85rem,5.3vw,6rem);line-height:.94;letter-spacing:-.075em;max-width:15ch}
  .story-records section{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;border-top:1px solid var(--ink);padding:1.4rem 0 3rem}
  .story-number{color:var(--signal)}.story-records h3{font-size:clamp(2rem,3.4vw,3.7rem);letter-spacing:-.06em;line-height:1;max-width:20ch}.story-records p{font-size:clamp(1.05rem,1.4vw,1.3rem);line-height:1.5;max-width:46rem;margin-top:1rem}
  .outcome-band{background:#dfeaed;padding-block:clamp(4rem,7vw,8rem)}
  .outcome-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;border-top:2px solid var(--ink);padding-top:1rem}
  .outcome-grid h2{font-size:clamp(3rem,5.5vw,6rem);line-height:.93;letter-spacing:-.075em;max-width:12ch;margin-top:1.2rem}
  .outcome-text{font-size:clamp(1.25rem,2vw,2rem);line-height:1.32;max-width:36rem}
  .boundary{border-top:1px solid var(--ink);margin-top:3rem;padding-top:1rem}.boundary span{color:var(--signal)}.boundary p{line-height:1.45;max-width:38rem;margin-top:.7rem}
  .case-next{display:flex;justify-content:space-between;gap:2rem;padding-block:3rem 4rem}.case-next>a:first-child{text-decoration:underline;text-underline-offset:.2em}.case-next>a:last-child{display:grid;grid-template-columns:1fr 2rem;gap:.6rem 1rem;max-width:28rem}.case-next>a:last-child span{grid-column:1/-1;color:var(--signal)}.case-next>a:last-child strong{font-family:var(--font-display);font-size:clamp(1.6rem,2.5vw,2.8rem);letter-spacing:-.05em;line-height:1}.case-next>a:last-child b{font-size:2rem;color:var(--signal)}
  @media(max-width:900px){.system-head{grid-template-columns:1fr 1fr}.system-head>.eyebrow{grid-column:1/-1}.system-steps{grid-template-columns:repeat(2,1fr)}.system-step:nth-child(2){border-right:0}.system-step:nth-child(n+3){border-top:1px solid #56717c}.system-step:nth-child(3){padding-left:0}}
  @media(max-width:700px){.flagship-case .case-title-block{grid-template-columns:1fr}.case-orbit{justify-self:start;max-width:16rem}.case-title-block h1{font-size:clamp(3.4rem,14vw,6rem)}}
  @media(max-width:600px){.case-rail{flex-wrap:wrap}.case-rail span:last-child{width:100%}.case-deck,.system-head,.story-intro,.story-records section,.outcome-grid{grid-template-columns:1fr}.case-actions{flex-direction:row;flex-wrap:wrap}.system-steps{grid-template-columns:1fr}.system-step,.system-step:first-child,.system-step:nth-child(3){min-height:13rem;border-right:0;border-top:1px solid #56717c;padding:1.2rem 0}.system-step:first-child{border-top:0}.system-step>div{margin-top:2rem}.system-foot{grid-template-columns:1fr;gap:.4rem}.story-intro,.story-records section{gap:.8rem}.story-intro h2{font-size:clamp(2.65rem,11vw,4.5rem)}.case-next{flex-direction:column}.case-next>a:last-child{margin-left:auto}}
</style>
