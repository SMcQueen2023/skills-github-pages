---
import Base from '../../layouts/Base.astro';
import { standaloneProjects, type StandaloneProject } from '../../data/standaloneProjects';

export function getStaticPaths() {
  const movedWorkSlugs = [
    'reporting-modernization',
    'reconciliation-automation',
    'portfolio-governance-platform',
    'sas-to-azure-migration',
    'enterprise-data-modeling',
    'external-analytics-enablement',
  ];
  return [
    ...standaloneProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })),
    ...movedWorkSlugs.map((redirectSlug) => ({ params: { slug: redirectSlug }, props: { redirectSlug } })),
  ];
}

const { project, redirectSlug } = Astro.props as { project?: StandaloneProject; redirectSlug?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const workDestination = redirectSlug ? `${base}/work/${redirectSlug}/` : '';
const index = project ? standaloneProjects.findIndex((entry) => entry.slug === project.slug) : -1;
const next = index >= 0 ? standaloneProjects[(index + 1) % standaloneProjects.length] : undefined;
---

{redirectSlug ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta http-equiv="refresh" content={`0; url=${workDestination}`} />
      <link rel="canonical" href={new URL(workDestination, Astro.site ?? 'https://smcqueen2023.github.io').href} />
      <meta property="og:image" content={new URL(`${base}/assets/social/decision-file.png`, Astro.site ?? 'https://smcqueen2023.github.io').href} />
      <title>Work case moved — Scott McQueen</title>
      <style is:global>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f2f6f7;color:#0c1722;font:1.1rem Arial,sans-serif}main{max-width:38rem;padding:2rem}h1{font-size:2.5rem;line-height:1}a{color:#0b707c;text-underline-offset:.2em}</style>
    </head>
    <body><main><h1>This work case has moved.</h1><p>Continue to the <a href={workDestination}>updated professional work case</a>.</p></main></body>
  </html>
) : project && (
  <Base title={`${project.title} — Scott McQueen`} description={project.summary} current="projects">
    <article>
      <header class="case-intro wrap">
        <div class="case-rail"><a href={`${base}/projects/`}>← Independent projects</a><span>{project.kind}</span></div>
        <p class="eyebrow case-status">{project.status}</p>
        <h1>{project.title}</h1>
        <p class="headline">{project.headline}</p>
        <p class="case-summary">{project.summary}</p>
        <div class="case-actions">
          {project.artifacts?.length && <a class="button" href="#artifacts">Inspect the artifacts <span aria-hidden="true">↓</span></a>}
          {project.liveUrl && <a class="action-link" href={project.liveUrl}>Open live project <span aria-hidden="true">↗</span></a>}
          {project.sourceUrl && <a class="action-link" href={project.sourceUrl}>View repository <span aria-hidden="true">↗</span></a>}
          <a class="action-link" href="#engineering">Engineering decisions <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="case-facts">
          <div><dt>My role</dt><dd>{project.role}</dd></div>
          <div><dt>Result & status</dt><dd>{project.outcome}</dd></div>
        </dl>
        <p class="scope-note">{project.boundary}</p>
      </header>

      {project.artifacts?.length && <section class="artifact-band" id="artifacts" aria-labelledby="artifact-heading">
        <div class="wrap">
          <div class="section-heading"><p class="eyebrow">Public evidence</p><div><h2 id="artifact-heading">Inspect the work.</h2><p>Each link opens the source file or working product described below.</p></div></div>
          <div class="artifact-grid">
            {project.artifacts.map((artifact) => <article class="artifact">
              <p class="mono">{artifact.kind}</p>
              <h3><a href={artifact.url}>{artifact.title} <span aria-hidden="true">↗</span></a></h3>
              <p>{artifact.caption}</p>
            </article>)}
          </div>
        </div>
      </section>}

      <section class="case-details wrap" aria-labelledby="question-heading">
        <div class="section-heading"><p class="eyebrow">The problem</p><h2 id="question-heading">{project.question}</h2></div>
        <div class="decision-list" aria-label="Key implementation choices">
          {project.highlights.map((item) => <div><h3>{item.label}</h3><p>{item.detail}</p></div>)}
        </div>
        <div class="story-records">
          <section id="approach"><p class="eyebrow">Approach</p><div><h3>{project.storyHeadings[0]}</h3><p>{project.approach}</p></div></section>
          <section id="engineering"><p class="eyebrow">Engineering</p><div><h3>{project.storyHeadings[1]}</h3><p>{project.engineering}</p></div></section>
          <section id="validation"><p class="eyebrow">Validation</p><div><h3>{project.storyHeadings[2]}</h3><p>{project.verification}</p></div></section>
        </div>
        <div class="tools"><span class="mono">Tools & methods</span><p>{project.stack.join(' · ')}</p></div>
      </section>

      <nav class="case-next wrap" aria-label="Continue through the portfolio">
        <a href={`${base}/work/`}>Professional delivery cases <span aria-hidden="true">↗</span></a>
        {next && <a href={`${base}/projects/${next.slug}/`}>Next project: {next.title} <span aria-hidden="true">↗</span></a>}
      </nav>
    </article>
  </Base>
)}

<style>
  .case-intro{padding-block:2.5rem clamp(3rem,5vw,4.5rem)}
  .case-rail{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--rule);padding-top:.8rem;color:var(--muted);font-family:var(--font-mono);font-size:.72rem;line-height:1.5}
  .case-rail a{text-decoration:underline;text-underline-offset:.25em}
  .case-status{margin-top:2.5rem}
  h1{font-size:clamp(2.8rem,6vw,5.6rem);letter-spacing:-.06em;line-height:1.02;max-width:21ch;margin:1rem 0 1.3rem}
  .headline{font-family:var(--font-display);font-size:clamp(1.4rem,2.4vw,2.2rem);letter-spacing:-.035em;line-height:1.2;max-width:35ch}
  .case-summary{font-size:clamp(1.08rem,1.65vw,1.35rem);max-width:51rem;margin-top:1.3rem;line-height:1.55}
  .case-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 2rem;margin-top:1.6rem}
  .case-facts{display:grid;grid-template-columns:1fr 1.4fr;gap:3rem;border-top:1px solid var(--rule);margin:2.5rem 0 0;padding-top:1.3rem}
  .case-facts dt{font-family:var(--font-mono);font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--signal)}
  .case-facts dd{margin:.65rem 0 0;line-height:1.55;max-width:44rem}
  .scope-note{color:var(--muted);font-size:.9rem;line-height:1.55;max-width:64rem;margin-top:1.5rem}
  .artifact-band{background:var(--ink);color:var(--paper-light);padding-block:clamp(3rem,5vw,4.5rem);scroll-margin-top:1.5rem}
  .section-heading{display:grid;grid-template-columns:.4fr 1fr;gap:3rem;border-top:1px solid var(--rule);padding-top:1rem;margin-bottom:2rem}
  .section-heading h2{font-size:clamp(2rem,3.6vw,3.5rem);letter-spacing:-.045em;line-height:1.08;max-width:24ch}
  .section-heading>div>p{margin-top:1rem;color:#c5d5db;max-width:40rem}
  .artifact-band .eyebrow,.artifact .mono{color:var(--signal-bright)}
  .artifact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 3rem}
  .artifact{border-top:1px solid #56717c;padding-top:1rem}
  .artifact h3{font-size:clamp(1.35rem,2vw,1.8rem);line-height:1.2;letter-spacing:-.025em;margin:.8rem 0}
  .artifact h3 a{color:#fff;text-decoration:underline;text-underline-offset:.2em;text-decoration-thickness:1px}
  .artifact h3 a:hover{color:var(--signal-bright)}
  .artifact>p:last-child{color:#c5d5db;line-height:1.6;max-width:41rem}
  .case-details{padding-block:clamp(3rem,5vw,5rem)}
  .decision-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.75rem;margin:2.5rem 0}
  .decision-list>div{border-left:3px solid var(--signal);padding-left:1rem}
  .decision-list h3{font-size:1.15rem;line-height:1.25;margin-bottom:.5rem}
  .decision-list p{color:var(--muted);font-size:.94rem;line-height:1.6}
  .story-records section{display:grid;grid-template-columns:.4fr 1fr;gap:3rem;border-top:1px solid var(--rule);padding:1.5rem 0 2.5rem;scroll-margin-top:1.5rem}
  .story-records h3{font-size:clamp(1.5rem,2.5vw,2.3rem);line-height:1.13;letter-spacing:-.035em;max-width:29ch}
  .story-records div>p{max-width:48rem;font-size:1.05rem;line-height:1.7;margin-top:1rem}
  .tools{border-top:1px solid var(--rule);padding-top:1rem;display:flex;flex-wrap:wrap;gap:.5rem 2rem;color:var(--muted)}
  .case-next{display:flex;justify-content:space-between;gap:2rem;border-top:1px solid var(--rule);padding-block:1.5rem 3rem}
  .case-next a{text-decoration:underline;text-underline-offset:.25em;line-height:1.6}
  @media(max-width:750px){.case-facts,.section-heading,.story-records section{grid-template-columns:1fr;gap:1rem}.artifact-grid{gap:1.5rem}.decision-list{grid-template-columns:1fr}.case-facts{gap:1.5rem}}
  @media(max-width:540px){h1{font-size:clamp(2.5rem,10.5vw,3.8rem)}.case-rail{flex-direction:column;gap:.4rem}.artifact-grid{grid-template-columns:1fr}.case-actions{align-items:start;gap:1rem}.case-actions .button{width:100%}.case-next{flex-direction:column;gap:1rem}.case-summary{font-size:1.05rem}}
</style>
