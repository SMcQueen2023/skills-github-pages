---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const experience = [
  {
    context: 'Accounting / enterprise reporting',
    title: 'Reporting modernization',
    role: 'Project lead and team Scrum Master; later Accounting business lead',
    contribution: 'I repaired the Power BI proof of concept, investigated query performance and upstream dependencies, and recommended a different migration approach. The VP accepted the recommendation; enterprise IT took on development of the broader solution.',
    status: 'Assessment and limited proof of concept completed; the wider estate was not migrated by this work.',
    href: '/work/reporting-modernization/',
  },
  {
    context: 'Freight / enterprise reporting',
    title: 'SAS-to-Azure migration planning',
    role: 'Project lead for a cross-team group of approximately ten contributors',
    contribution: 'I built the business case and secured VP sponsorship. The team inventoried 170 reports, worked with IT on the technical direction, and migrated initial proof-of-concept reports. I ran Power BI office hours to work through implementation questions with colleagues.',
    status: 'Sponsorship, inventory, planning, and early proofs of concept established before I left the project.',
    href: '/work/sas-to-azure-migration/',
  },
  {
    context: 'Accounting / analytics automation',
    title: 'Monthly contribution reconciliation',
    role: 'Workflow design and hands-on implementation',
    contribution: 'I automated aggregation and reconciliation across 30 monthly source files using Azure Synapse, SQL, and Python, replacing manual contribution calculations with a repeatable workflow.',
    status: 'Automated monthly aggregation and reconciliation delivered.',
    href: '/work/reconciliation-automation/',
  },
  {
    context: 'Enterprise / reporting and data modeling',
    title: 'Portfolio measures and accounting models',
    role: 'BI development and data-model design',
    contribution: 'I connected SharePoint intake and project activity to Power BI portfolio measures. In a separate revenue accounting proof of concept, I designed fact and dimension structures around the reporting questions.',
    status: 'Portfolio reporting delivered; revenue accounting model remained a proof of concept.',
    href: '/work/portfolio-governance-platform/',
  },
];
---

<Base title="Experience — Scott McQueen | Analytics delivery" description="Enterprise analytics experience across accounting and freight: migration assessment, cross-team delivery, Power BI office hours, and reporting automation." current="experience">
  <header class="page-lead wrap">
    <div class="lead-meta"><p class="eyebrow">Experience</p><span class="mono">Enterprise analytics / accounting / freight</span></div>
    <h1>Hands-on analytics. Responsibility for delivery.</h1>
    <p class="lead-text">My foundation is senior BI and data analysis. I have led project teams, shaped reporting decisions with business and IT stakeholders, and helped colleagues build their own solutions through live working sessions.</p>
    <div class="page-actions"><a class="button" href={profile.linkedin}>Request my résumé on LinkedIn <span aria-hidden="true">↗</span></a><a class="action-link" href={`${base}/work/`}>View case studies <span aria-hidden="true">↗</span></a></div>
  </header>

  <section class="editorial-section wrap" aria-labelledby="record-heading">
    <div class="editorial-grid">
      <p class="eyebrow">Selected enterprise experience</p>
      <div>
        <h2 id="record-heading">Business context, contribution, and result.</h2>
        <p class="section-intro">The roles below describe my responsibilities on each initiative.</p>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-entry">
              <p class="mono">{item.context}</p>
              <div class="entry-detail">
                <h3>{item.title}</h3>
                <p class="role"><strong>My role:</strong> {item.role}</p>
                <p>{item.contribution}</p>
                <p class="status"><strong>Result:</strong> {item.status}</p>
                <a class="action-link" href={`${base}${item.href}`}>Read case study <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="enablement-band" aria-labelledby="enablement-heading">
    <div class="wrap editorial-grid">
      <p class="eyebrow">Helping colleagues deliver</p>
      <div>
        <h2 id="enablement-heading">Make room for the working session.</h2>
        <p>Weekly Power BI, SQL, and SAS office hours gave colleagues a place to bring questions and build solutions together. During the SAS migration effort, I worked through Power BI report construction live so report owners could make progress on their own work.</p>
        <a class="action-link" href={`${base}/work/sas-to-azure-migration/#collaboration`}>See the collaboration <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-lead h1{max-width:20ch;font-size:clamp(2.8rem,5.5vw,4.8rem)}
  .page-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 2rem;margin-top:1.7rem}
  .section-intro{max-width:45rem;margin-top:1rem;color:var(--muted)}
  .experience-list{margin-top:2rem;border-top:2px solid var(--ink)}
  .experience-entry{display:grid;grid-template-columns:minmax(10rem,.32fr) minmax(0,1fr);gap:2.5rem;padding:2rem 0;border-bottom:1px solid var(--rule)}
  .experience-entry>.mono{max-width:22ch;color:var(--signal)}
  .entry-detail{max-width:51rem}.entry-detail h3{font-size:clamp(1.6rem,2.6vw,2.6rem);letter-spacing:-.04em}
  .entry-detail p{margin-top:1rem;font-size:1.05rem}.entry-detail .role{color:var(--muted);font-size:.98rem}.entry-detail .status{padding-left:1rem;border-left:3px solid var(--signal);font-size:.95rem}.entry-detail .action-link{margin-top:1rem}
  .enablement-band{background:#dfeaed;padding-block:clamp(3rem,5vw,5rem)}.enablement-band p:not(.eyebrow){max-width:49rem;margin-top:1.25rem;font-size:1.15rem}.enablement-band .action-link{margin-top:1.5rem}
  @media(max-width:700px){.experience-entry{grid-template-columns:1fr;gap:.75rem}.experience-entry>.mono{max-width:none}.page-lead .lead-meta{flex-wrap:wrap}}
</style>
