---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { featuredProjects } from '../data/projects';
import { sitePath } from '../lib/urls';
---
<Base title="Scott McQueen — Analytics leadership & technical delivery" description="Senior analytics professional connecting business priorities, technical decisions, and team capability. Explore BI leadership, migration planning, and hands-on analytics work." current="home">
  <section class="home-intro wrap" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">Scott McQueen / Business intelligence & analytics</p>
      <h1 id="intro-title">Leading analytics <em>delivery.</em></h1>
      <p class="intro-summary">I turn business needs into reliable reporting, guide technical decisions, and help colleagues build and use analytics.</p>
      <p class="intro-context">My foundation is senior BI and data analysis in enterprise accounting and freight reporting—with hands-on work in SQL, Power BI, Python, SAS, and Azure.</p>
      <div class="action-group">
        <a class="button" href="#selected-work">Explore the work <span aria-hidden="true">↗</span></a>
        <a class="action-link" href={sitePath('/contact/')}>Discuss an opportunity <span aria-hidden="true">↗</span></a>
      </div>
      <a class="intro-link text-link" href="https://www.linkedin.com/in/smmcqueen/">Request my résumé on LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="intro-record" aria-label="Professional profile">
      <p class="eyebrow">The work I bring</p>
      <dl>
        <div><dt>Direction</dt><dd>Business cases, platform decisions, and reporting priorities</dd></div>
        <div><dt>People</dt><dd>Cross-team coordination, Office Hours, and live technical coaching</dd></div>
        <div><dt>Execution</dt><dd>Migration assessment, data modeling, and analytical automation</dd></div>
      </dl>
      <p class="intro-fit">Interested in <strong>BI / Analytics Manager</strong>, Technical Project Manager, and Analytics Engineer opportunities.</p>
      <a class="text-link" href="https://www.linkedin.com/in/smmcqueen/">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <nav class="review-paths wrap" aria-label="Explore the evidence by focus">
    <span class="eyebrow">Explore by focus</span>
    <a href={sitePath('/work/#analytics-leadership')}>Analytics leadership <span aria-hidden="true">↗</span></a>
    <a href={sitePath('/work/#technical-delivery')}>Technical delivery <span aria-hidden="true">↗</span></a>
    <a href={sitePath('/work/#data-engineering')}>Data & engineering <span aria-hidden="true">↗</span></a>
  </nav>

  <section class="leadership-evidence" aria-labelledby="leadership-heading">
    <div class="wrap evidence-layout">
      <div><p class="eyebrow">Leadership in practice</p><h2 id="leadership-heading">Improve the work.<br />Help others do it.</h2></div>
      <div class="evidence-items">
        <article><h3>Make analytics useful to leadership</h3><p>I built and maintain a cost-center scorecard used by senior Accounting and Tax leaders to monitor cost-saving initiatives.</p></article>
        <article><h3>Build colleagues’ capability</h3><p>I hosted weekly Power BI, SQL, and SAS Office Hours, working through reports and technical questions with colleagues in live sessions.</p><a class="text-link" href={sitePath('/work/sas-to-azure-migration/#collaboration')}>See coaching in a migration effort <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>

  <section id="selected-work" class="section-space wrap" aria-labelledby="work-heading">
    <div class="section-heading-row"><div><p class="eyebrow">Selected professional work</p><h2 id="work-heading">The responsibility.<br />The decision. The result.</h2></div><p>Four cases show how I align people, evaluate technical options, and make reporting more reliable. Each opens with my role and the work’s status.</p></div>
    <div class="case-card-grid">{featuredProjects.map(project => <CaseCard project={project} />)}</div>
    <a class="action-link section-action" href={sitePath('/work/')}>All professional work <span aria-hidden="true">↗</span></a>
  </section>

  <section class="career-band" aria-labelledby="career-heading">
    <div class="wrap career-layout">
      <div><p class="eyebrow">Experience & credentials</p><h2 id="career-heading">Business context.<br />Technical grounding.</h2><p>My work spans enterprise accounting, freight reporting, and an external analytics engagement. I have served as project lead, team Scrum Master, and Accounting business lead while staying close to the data and implementation.</p><a class="text-link" href={sitePath('/experience/')}>Explore my experience ↗</a></div>
      <div class="qualification-record"><p class="eyebrow">Selected credentials</p><ul><li><strong>Project Management Professional</strong><span>PMI / PMP</span></li><li><strong>Power BI Data Analyst Associate</strong><span>Microsoft</span></li><li><a class="text-link" href="https://learn.microsoft.com/en-us/users/scottmcqueen-9826/credentials/f7ee0ff733a8bfdf"><strong>Fabric Data Engineer Associate ↗</strong></a><span>Microsoft / Received September 25, 2026</span></li></ul><a class="text-link" href={sitePath('/certifications/')}>Credential details & verification ↗</a></div>
    </div>
  </section>

  <section class="technical-entry wrap" aria-labelledby="technical-heading">
    <div><p class="eyebrow">Inspect the implementation</p><h2 id="technical-heading">Go from the case to the code.</h2></div>
    <div><p>Explore public engineering projects alongside the professional cases. Source links and technical notes identify independent builds, demonstrations, and academic work.</p><a class="action-link" href={sitePath('/projects/finance-analytics-platform/#artifacts')}>Inspect SQL & data tests <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="contact-invitation wrap" aria-labelledby="contact-heading">
    <p class="eyebrow">Let’s talk</p><h2 id="contact-heading">Looking for someone to lead analytics delivery?</h2><p>Let’s discuss the team, the reporting challenges, and the outcomes you need.</p><div class="action-group"><a class="button" href={sitePath('/contact/')}>Discuss an opportunity <span aria-hidden="true">↗</span></a><a class="text-link" href="https://www.linkedin.com/in/smmcqueen/">LinkedIn ↗</a></div>
  </section>
</Base>
