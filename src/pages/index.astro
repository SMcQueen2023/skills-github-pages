---
import Base from '../layouts/Base.astro';
import { featuredProjects } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const visuals: Record<string, { file: string; alt: string }> = {
  'reporting-modernization': {
    file: 'reporting-lineage.svg',
    alt: 'Sanitized schematic tracing BusinessObjects report behavior through definition, SQL translation, and validation.',
  },
  'reconciliation-automation': {
    file: 'reconciliation-trace.svg',
    alt: 'Sanitized reconciliation process with separate landing, matching, validation, and reviewable exception path.',
  },
  'portfolio-governance-platform': {
    file: 'governance-health.svg',
    alt: 'Sanitized model showing intake and delivery signals feeding an explainable portfolio health view.',
  },
};
---
<Base
  title="Scott McQueen — BI, reporting, automation and technical delivery"
  description="Scott McQueen turns fragile reporting and manual workflows into systems leaders can examine, trust, and operate. Selected work in BI, automation, and technical delivery."
  current="home"
>
  <section class="cover wrap" aria-labelledby="cover-title">
    <div class="cover-top">
      <p class="cover-ident"><strong>Scott McQueen</strong><span class="mono">Decision File 00</span></p>
      <span class="mono">Business intelligence · Reporting · Automation · Technical delivery</span>
    </div>
    <h1 id="cover-title">I make the numbers <em>hold up.</em></h1>
    <div class="cover-bottom">
      <p class="cover-descriptor">I turn fragile reporting and manual workflows into systems people can examine, trust, and run.</p>
      <p class="cover-context">Hands-on architecture, stakeholder alignment, validation, and delivery for decisions that carry real operating weight.</p>
      <a class="action-link" href={`${base}/projects/`}>Open the work <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="thesis" aria-labelledby="thesis-heading">
    <div class="wrap">
      <div class="thesis-head">
        <p class="eyebrow">01 / The operating pattern</p>
        <h2 id="thesis-heading">Make meaning survive the move.</h2>
      </div>
      <div class="trace-grid" role="group" aria-label="Reporting modernization decision sequence">
        <div class="trace-step">
          <p class="mono">01 / Source</p>
          <h3>Inherited behavior</h3>
          <p>Calculations and filters live inside legacy reports, with meaning that may be hard to inspect.</p>
        </div>
        <div class="trace-step">
          <p class="mono">02 / Judgment</p>
          <h3>Interpret the metric</h3>
          <p>Separate the intended business definition from historical workarounds and presentation choices.</p>
        </div>
        <div class="trace-step">
          <p class="mono">03 / Control</p>
          <h3>Translate and compare</h3>
          <p>Express reusable logic in SQL; reconcile calculations, filters, and known outputs.</p>
        </div>
        <div class="trace-step">
          <p class="mono">04 / Use</p>
          <h3>A result that holds up</h3>
          <p>Give finance reporting a clearer basis for continuity, review, and future change.</p>
        </div>
      </div>
      <div class="thesis-foot">
        <p><strong>A real decision from the reporting modernization work:</strong> move the metric definition before the replacement screen.</p>
        <p>This is a sanitized abstraction of the process. <a class="action-link" href={`${base}/projects/reporting-modernization/`}>See the case <span aria-hidden="true">↗</span></a></p>
      </div>
    </div>
  </section>

  <section class="ledger wrap" aria-labelledby="ledger-heading">
    <div class="ledger-heading">
      <p class="eyebrow">02 / Evidence with context</p>
      <h2 id="ledger-heading">The work has a scale. The details matter.</h2>
    </div>
    <div class="ledger-row">
      <span class="ledger-number">170<span class="signal-dot">+</span></span>
      <div><h3>Reporting assets in modernization scope</h3><p>An enterprise reporting estate where metric meaning and business continuity shape the migration. This is scope, not a completed migration count.</p></div>
      <a class="action-link" href={`${base}/projects/reporting-modernization/`}>Reporting file <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ledger-row">
      <span class="ledger-number">~30<span class="signal-dot">h</span></span>
      <div><h3>Monthly manual effort removed across automation work</h3><p>The prior site reports this portfolio-level signal. The reconciliation case shows the controlled architecture; its individual share of the saving is not itemized.</p></div>
      <a class="action-link" href={`${base}/projects/reconciliation-automation/`}>Automation file <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ledger-row">
      <span class="ledger-number">03<span class="signal-dot">.</span></span>
      <div><h3>Ways the operating system changes</h3><p>Clearer reporting logic, auditable automation, and portfolio health derived from observed delivery behavior.</p></div>
      <a class="action-link" href={`${base}/projects/`}>All files <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="work-section wrap" aria-labelledby="work-heading">
    <div class="work-heading">
      <p class="eyebrow">03 / Selected case files</p>
      <h2 id="work-heading">Three problems. Three kinds of proof.</h2>
      <p>Each file shows the question, the consequential design choice, and how the result was checked. The diagrams are sanitized reconstructions of the work.</p>
    </div>
    {featuredProjects.map((project) => (
      <article class="case-preview">
        <div class="case-copy">
          <p class="folio"><span>{project.number} / {project.lane}</span><span>{project.context}</span></p>
          <h3>{project.headline}</h3>
          <p>{project.summary}</p>
          <a class="action-link" href={`${base}/projects/${project.slug}/`}>Read decision file <span aria-hidden="true">↗</span></a>
        </div>
        <div class="case-visual" role="group" tabindex="0" aria-label={`Scrollable visual exhibit for ${project.title}`}>
          <img src={`${base}/assets/illustrations/${visuals[project.slug].file}`} alt={visuals[project.slug].alt} loading="lazy" />
        </div>
      </article>
    ))}
    <div class="work-all"><a class="action-link" href={`${base}/projects/`}>View all work <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="method-band" aria-labelledby="method-heading">
    <div class="wrap">
      <div class="method-heading">
        <p class="eyebrow">04 / How I deliver</p>
        <h2 id="method-heading">A method built for messy reality.</h2>
      </div>
      <div class="method-steps">
        <div class="method-step"><p class="folio">01</p><h3>Frame the decision</h3><p>Find the question the reporting or workflow must answer.</p></div>
        <div class="method-step"><p class="folio">02</p><h3>Align the owners</h3><p>Make definitions, tradeoffs, and delivery constraints visible across teams.</p></div>
        <div class="method-step"><p class="folio">03</p><h3>Design the system</h3><p>Choose data structure, automation boundaries, and supportable steps.</p></div>
        <div class="method-step"><p class="folio">04</p><h3>Prove the signal</h3><p>Reconcile outputs, test assumptions, and expose exceptions.</p></div>
        <div class="method-step"><p class="folio">05</p><h3>Make it usable</h3><p>Deliver a result people can explain and operate after launch.</p></div>
      </div>
      <div class="method-end">
        <div><h3>AI-assisted development, openly.</h3><p>I use Gemini, GitHub Copilot, and Codex to explore approaches, draft implementation, and review work. I own the problem framing, architecture, validation, and final result.</p></div>
        <div><p>Technical delivery needs judgment beyond the generated code: what the system should do, which constraints matter, and how its output is checked. I document that boundary in the work.</p><a class="action-link" href={`${base}/about/#ai-method`}>Read my approach <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="closing wrap" aria-labelledby="closing-heading">
    <p class="eyebrow">05 / Next conversation</p>
    <h2 id="closing-heading">Need the numbers to <em>hold up?</em></h2>
    <a class="action-link" href={`${base}/contact/`}>Start a conversation <span aria-hidden="true">↗</span></a>
  </section>
</Base>
