---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Contact — Scott McQueen | Analytics leadership and delivery" description="Connect with Scott McQueen on LinkedIn about BI and Analytics Manager, Technical Project Manager, or Analytics Engineer opportunities. Request a résumé directly." current="contact">
  <header class="page-lead wrap">
    <div class="lead-meta"><p class="eyebrow">Contact</p><span class="mono">Let's discuss the work</span></div>
    <h1>Start a conversation on LinkedIn.</h1>
    <p class="lead-text">I welcome conversations about BI and Analytics Manager, Technical Project Manager, and Analytics Engineer opportunities where business judgment and technical delivery matter.</p>
    <a class="button contact-primary" href={profile.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a>
    <p class="resume-note">For my résumé or more detail on an engagement, <a href={profile.linkedin}>reach out via LinkedIn</a>.</p>
  </header>

  <section class="editorial-section wrap" aria-labelledby="conversation-heading">
    <div class="editorial-grid">
      <p class="eyebrow">A useful starting point</p>
      <div>
        <h2 id="conversation-heading">What does your analytics team need to deliver?</h2>
        <p class="conversation-copy">Tell me about the role, the business problem, and the people who depend on the result. I can walk through how I have aligned contributors, tested platform choices, supported colleagues, and built reporting workflows.</p>
        <div class="contact-options">
          <a href={profile.linkedin}><span class="mono">Profile and résumé requests</span><strong>LinkedIn</strong><span aria-hidden="true">↗</span></a>
          <a href={`${base}/work/`}><span class="mono">Enterprise contribution</span><strong>Case studies</strong><span aria-hidden="true">↗</span></a>
          <a href={profile.github}><span class="mono">Inspectable project code</span><strong>GitHub</strong><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-lead h1{max-width:18ch;font-size:clamp(2.8rem,5.5vw,4.8rem)}
  .contact-primary{margin-top:1.8rem}.resume-note{max-width:44rem;margin-top:1.15rem;color:var(--muted);font-size:1rem}.resume-note a{text-decoration:underline;text-underline-offset:3px;color:var(--ink)}
  .conversation-copy{max-width:49rem;font-size:1.15rem;margin-top:1.3rem}
  .contact-options{margin-top:2rem;border-top:2px solid var(--ink)}.contact-options a{display:grid;grid-template-columns:minmax(10rem,.4fr) minmax(0,1fr) auto;gap:1.5rem;align-items:center;padding:1.6rem 0;border-bottom:1px solid var(--rule)}
  .contact-options .mono{color:var(--muted);max-width:23ch}.contact-options strong{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,3rem);line-height:1.05;letter-spacing:-.04em}.contact-options a>span:last-child{font-size:1.7rem}
  @media(max-width:600px){.contact-options a{grid-template-columns:1fr auto;gap:.5rem}.contact-options .mono{grid-column:1/-1;max-width:none}.page-lead .lead-meta{flex-wrap:wrap}}
</style>
