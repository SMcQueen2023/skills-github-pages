---
import Base from '../layouts/Base.astro';
import { profile, selectedCredentials, additionalCredentials } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Credentials — Scott McQueen | PMP, Power BI, Fabric" description="Scott McQueen's selected credentials: PMP, Microsoft Power BI Data Analyst, and Fabric Data Engineer Associate, received September 25, 2026." current="credentials">
  <header class="page-lead wrap">
    <div class="lead-meta"><p class="eyebrow">Credentials</p><span class="mono">Delivery / business intelligence / data</span></div>
    <h1>Credentials that support the work.</h1>
    <p class="lead-text">Project management discipline, Power BI reporting, and data engineering knowledge complement my enterprise analytics experience.</p>
  </header>

  <section class="editorial-section wrap" aria-labelledby="selected-heading">
    <div class="editorial-grid">
      <p class="eyebrow">Selected certifications</p>
      <div>
        <h2 id="selected-heading">PMP, Power BI, and Fabric.</h2>
        <div class="credential-list">
          {selectedCredentials.map((item) => (
            <article class="credential-row">
              <div><p class="mono">{item.issuer}</p><h3>{item.name}</h3><p class="credential-date">{item.date}</p></div>
              <a class="action-link" href={item.href}>{item.shortName === 'Fabric Data Engineer' ? 'View credential' : 'Issuer profile'} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="verification-note">Issuer profiles provide verification and current status. The case studies show how I apply technical knowledge to delivery decisions.</p>
      </div>
    </div>
  </section>

  <section class="editorial-section wrap" aria-labelledby="additional-heading">
    <div class="editorial-grid">
      <p class="eyebrow">Additional study and certification</p>
      <div>
        <h2 id="additional-heading">A broader analytical foundation.</h2>
        <ul class="additional-list">
          {additionalCredentials.map((item) => (
            <li><h3>{item.name}</h3><p>{item.issuer} · {item.date}</p></li>
          ))}
        </ul>
        <div class="profile-links"><a class="action-link" href={profile.microsoftTranscript}>Microsoft transcript <span aria-hidden="true">↗</span></a><a class="action-link" href={profile.credly}>Credly profile <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="applied-band">
    <div class="wrap"><p class="eyebrow">Applied experience</p><h2>See the decisions behind the credentials.</h2><p>Explore migration planning, technical assessment, and automated reconciliation in the enterprise case studies.</p><a class="action-link" href={`${base}/work/`}>View selected work <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>

<style>
  .page-lead h1{max-width:18ch;font-size:clamp(2.8rem,5.5vw,4.8rem)}
  .credential-list{margin-top:2rem;border-top:2px solid var(--ink)}
  .credential-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:center;padding:1.6rem 0;border-bottom:1px solid var(--rule)}
  .credential-row .mono{color:var(--signal)}.credential-row h3{max-width:33ch;font-size:clamp(1.5rem,2.4vw,2.35rem);letter-spacing:-.04em;margin-top:.5rem}.credential-date{margin-top:.75rem;color:var(--muted)}
  .credential-row .action-link{white-space:nowrap}.verification-note{max-width:48rem;color:var(--muted);margin-top:1.2rem;font-size:.92rem}
  .additional-list{list-style:none;margin:1.75rem 0 0;padding:0;max-width:55rem}.additional-list li{padding:1.25rem 0;border-top:1px solid var(--rule)}.additional-list h3{font-size:1.3rem;line-height:1.25}.additional-list p{color:var(--muted);margin-top:.5rem}
  .profile-links{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:1.1rem}
  .applied-band{background:#dfeaed;padding-block:clamp(3rem,5vw,5rem)}.applied-band h2{max-width:24ch;font-size:clamp(2rem,3.8vw,3.75rem);letter-spacing:-.05em;margin-top:1rem}.applied-band p:not(.eyebrow){max-width:43rem;margin-top:1.25rem;font-size:1.1rem}.applied-band .action-link{margin-top:1.5rem}
  @media(max-width:700px){.credential-row{grid-template-columns:1fr;gap:.8rem}.credential-row .action-link{justify-self:start}.page-lead .lead-meta{flex-wrap:wrap}}
</style>
