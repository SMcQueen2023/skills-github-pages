---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const practices = [
  {
    label: 'Business judgment',
    title: 'Make the technical decision useful to the business.',
    body: 'In the BusinessObjects assessment, I combined proof-of-concept reports, query plans, and Power BI Service testing to explain where the proposed migration would break down. I recommended a different approach, which the VP accepted.',
    href: '/work/reporting-modernization/#decision',
    link: 'Read the platform decision',
  },
  {
    label: 'People and delivery',
    title: 'Help the people doing the work make progress.',
    body: 'For the SAS-to-Azure effort, I secured sponsorship and led a cross-team group through inventory, planning, and early proofs of concept. Power BI office hours gave report owners a place to develop reports and resolve questions together.',
    href: '/work/sas-to-azure-migration/#collaboration',
    link: 'See the collaboration',
  },
  {
    label: 'Quality and accountability',
    title: 'Establish what the data can support.',
    body: 'In an external ministry analytics engagement, I rebuilt inconsistent workbook data and checked the records before presenting the findings. I kept unresolved source totals visible and recommended a simpler process for recurring reporting.',
    href: '/work/external-analytics-enablement/#validation',
    link: 'Review the validation work',
  },
];
---

<Base title="Approach — Scott McQueen | Leading analytics delivery" description="How Scott McQueen combines business judgment, cross-team coordination, technical assessment, and practical coaching to lead analytics delivery." current="about">
  <header class="page-lead wrap">
    <div class="lead-meta"><p class="eyebrow">Approach</p><span class="mono">Judgment / collaboration / follow-through</span></div>
    <h1>Lead the work. Help others deliver.</h1>
    <p class="lead-text">I am a senior BI and analytics professional who works between business stakeholders and technical teams. I turn business needs into reporting decisions, coordinate the people involved, and stay close enough to the implementation to test whether it works.</p>
  </header>

  <section class="editorial-section wrap" aria-labelledby="practice-heading">
    <div class="editorial-grid">
      <p class="eyebrow">Leadership in practice</p>
      <div>
        <h2 id="practice-heading">The responsibility behind the analysis.</h2>
        <p class="practice-intro">My leadership experience comes through project ownership, technical direction, and practical coaching. These examples show what that responsibility involved.</p>
        <div class="practice-list">
          {practices.map((practice) => (
            <article>
              <p class="mono">{practice.label}</p>
              <div><h3>{practice.title}</h3><p>{practice.body}</p><a class="action-link" href={`${base}${practice.href}`}>{practice.link} <span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="working-section" aria-labelledby="working-heading">
    <div class="wrap editorial-grid">
      <p class="eyebrow">Working with a team</p>
      <div>
        <h2 id="working-heading">A working session can move the work forward.</h2>
        <div class="editorial-copy">
          <p>I have hosted weekly Power BI, SQL, and SAS office hours, using live development and practical questions to help colleagues build self-service capability. Teaching the next step is part of the delivery work.</p>
          <p>The same approach carries into stakeholder conversations: establish the business need, make the tradeoffs clear, and identify the decision or action that lets the team proceed.</p>
        </div>
        <a class="action-link" href={`${base}/experience/`}>Explore my experience <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="editorial-section wrap ai-section" id="ai-method" aria-labelledby="ai-heading">
    <div class="editorial-grid">
      <p class="eyebrow">Development practice</p>
      <div>
        <h2 id="ai-heading">AI assistance, with ownership of the result.</h2>
        <div class="editorial-copy">
          <p>I use tools such as GitHub Copilot, Gemini, and Codex to explore options, implement changes, and look for issues. I set requirements, choose the architecture, review changes, and check behavior against the intended result.</p>
          <p>This portfolio includes AI-assisted development. I review suggested code against source definitions, validation checks, and the team's ability to operate the result.</p>
        </div>
        <a class="action-link" href={profile.linkedin}>Discuss an opportunity <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-lead h1{max-width:19ch;font-size:clamp(2.8rem,5.5vw,4.8rem)}
  .practice-intro{max-width:49rem;margin-top:1.25rem;font-size:1.1rem;color:var(--muted)}
  .practice-list{margin-top:2rem;border-top:2px solid var(--ink)}.practice-list article{display:grid;grid-template-columns:minmax(9rem,.3fr) minmax(0,1fr);gap:2rem;padding:2rem 0;border-bottom:1px solid var(--rule)}
  .practice-list article>.mono{color:var(--signal);max-width:20ch}.practice-list h3{max-width:30ch;font-size:clamp(1.6rem,2.6vw,2.6rem);letter-spacing:-.04em}.practice-list article div>p{max-width:47rem;margin-top:1rem;font-size:1.05rem}.practice-list .action-link{margin-top:1.1rem}
  .working-section{background:#dfeaed;padding-block:clamp(3rem,5vw,5rem)}.working-section .editorial-copy,.ai-section .editorial-copy{margin-top:1.5rem;font-size:1.1rem;max-width:48rem}.working-section .action-link,.ai-section .action-link{margin-top:1.5rem}.ai-section{border-top:0}
  @media(max-width:700px){.practice-list article{grid-template-columns:1fr;gap:.7rem}.practice-list article>.mono{max-width:none}.page-lead .lead-meta{flex-wrap:wrap}}
</style>
