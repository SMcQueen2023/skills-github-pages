---
import Base from '../../layouts/Base.astro';
import { workProjects, type Project } from '../../data/projects';
import { sitePath } from '../../lib/urls';

export function getStaticPaths() {
  return workProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const next = workProjects[(workProjects.findIndex(item => item.slug === project.slug) + 1) % workProjects.length];
const illustrations: Record<string, { file: string; alt: string }> = {
  'reporting-modernization': { file: 'reporting-lineage', alt: 'The Power BI proof of concept, query plans, service tests, and dependency analysis informed a change in the SAP BusinessObjects migration approach.' },
  'reconciliation-automation': { file: 'reconciliation-trace', alt: 'Thirty monthly contribution files flow into Blob Storage, through Synapse and SQL aggregation, to reconciliation and a balance report. Python supports result validation.' },
  'portfolio-governance-platform': { file: 'governance-health', alt: 'SharePoint intake, project and time data, and DAX measures connect recorded activity with a portfolio reporting view.' },
};
const illustration = illustrations[project.slug];
---
<Base title={project.title + ' — Scott McQueen'} description={project.summary} current="work">
  <article class="professional-case wrap">
    <header class="case-intro">
      <a class="text-link" href={sitePath('/work/')}>← Professional work</a>
      <p class="eyebrow">{project.context}</p>
      <h1>{project.title}</h1>
      <p class="case-standfirst">{project.summary}</p>
      <span class="case-status">{project.status}</span>
      <dl class="case-overview">
        <div><dt>Business question</dt><dd>{project.question}</dd></div>
        <div><dt>My role & scope</dt><dd>{project.role}</dd></div>
        <div><dt>Consequential contribution</dt><dd>{project.contribution}</dd></div>
        <div><dt>Outcome</dt><dd>{project.result}</dd></div>
      </dl>
      <nav class="case-contents" aria-label="In this case"><a href="#decision">Decision</a><a href="#delivery">Delivery</a><a href="#collaboration">Collaboration</a><a href="#engineering">Technical detail</a><a href="#validation">Validation</a><a href="#outcome">Outcome</a></nav>
    </header>
    <div class="case-reading-layout">
      <aside class="case-context"><p class="eyebrow">Case context</p><p>{project.lane}</p><h2>Tools & methods</h2><ul>{project.tools.map(tool => <li>{tool}</li>)}</ul><a class="text-link" href={sitePath('/contact/')}>Discuss this work ↗</a></aside>
      <div class="case-prose">
        <section id="decision"><p class="eyebrow">01 / Judgment</p><h2>The problem and the choice</h2><p>{project.situation}</p><p>{project.decision}</p></section>
        <section id="delivery"><p class="eyebrow">02 / Delivery responsibility</p><h2>What I owned</h2><p>{project.approach}</p><ul>{project.delivery.map(item => <li>{item}</li>)}</ul></section>
        <section id="collaboration"><p class="eyebrow">03 / Working with others</p><h2>How the work moved forward</h2><p>{project.collaboration}</p></section>
        <section id="engineering"><p class="eyebrow">04 / Technical detail</p><h2>The implementation decisions</h2><dl class="technical-details">{project.technicalDetails.map(item => <div><dt>{item.label}</dt><dd>{item.detail}</dd></div>)}</dl>
          {illustration && <figure class="case-diagram"><a href={sitePath('/assets/illustrations/' + illustration.file + '.svg')} aria-label="Open full-size explanatory diagram"><img src={sitePath('/assets/illustrations/' + illustration.file + '.svg')} alt={illustration.alt} width="1200" height="720" loading="lazy" /></a><figcaption><strong>Public reconstruction.</strong> {project.artifactCaption} <a class="text-link" href={sitePath('/assets/illustrations/' + illustration.file + '.svg')}>Open full-size diagram ↗</a></figcaption></figure>}
          {project.evidenceLinks?.length > 0 && <div class="case-artifact-links"><h3>Inspect the artifacts</h3>{project.evidenceLinks.map(link => <article><a class="text-link" href={link.url}>{link.label} ↗</a><p>{link.detail}</p></article>)}</div>}
        </section>
        <section id="validation"><p class="eyebrow">05 / Validation</p><h2>Validation evidence</h2><p>{project.validation}</p></section>
        <section id="outcome" class="case-outcome"><p class="eyebrow">06 / Outcome & status</p><h2>What changed</h2><p>{project.result}</p><p class="case-scope-note">{project.boundary}</p></section>
      </div>
    </div>
    <nav class="case-next-nav" aria-label="Continue reading"><a class="text-link" href={sitePath('/work/')}>← All professional work</a><a href={sitePath('/work/' + next.slug + '/')}><span class="eyebrow">Next case</span><strong>{next.title} ↗</strong></a></nav>
  </article>
</Base>
