---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { featuredProjects, supportingProjects } from '../../data/projects';
import { sitePath } from '../../lib/urls';
const paths = [
  { id: 'analytics-leadership', title: 'Analytics leadership', description: 'Business judgment, stakeholder alignment, and helping colleagues deliver.', links: [
    { label: 'SAS migration: sponsorship and Office Hours', path: '/work/sas-to-azure-migration/#collaboration' },
    { label: 'SAP assessment: evidence that changed direction', path: '/work/reporting-modernization/#outcome' },
    { label: 'Ministry analytics: a decision-ready leadership view', path: '/work/external-analytics-enablement/#collaboration' },
  ] },
  { id: 'technical-delivery', title: 'Technical delivery', description: 'The scope, dependencies, decisions, and coordination I owned.', links: [
    { label: 'SAS migration: business case, inventory, and planning', path: '/work/sas-to-azure-migration/#delivery' },
    { label: 'SAP assessment: project lead and Scrum Master responsibilities', path: '/work/reporting-modernization/#delivery' },
    { label: 'Portfolio governance: the reporting system', path: '/work/portfolio-governance-platform/#delivery' },
  ] },
  { id: 'data-engineering', title: 'Data & engineering', description: 'Transformation, modeling, validation, and inspectable public implementations.', links: [
    { label: '401(k) reconciliation: aggregation and comparison', path: '/work/reconciliation-automation/#engineering' },
    { label: 'Revenue accounting: grain and model relationships', path: '/work/enterprise-data-modeling/#engineering' },
    { label: 'Independent finance platform: SQL and data tests', path: '/projects/finance-analytics-platform/#artifacts' },
  ] },
];
---
<Base title="Work — Analytics leadership, delivery & engineering | Scott McQueen" description="Professional cases in migration planning, team enablement, reporting automation, and analytical validation. Find Scott McQueen’s contribution, results, and technical detail." current="work">
  <header class="page-lead wrap"><p class="eyebrow">Professional work</p><h1>Decisions and delivery, in context.</h1><p class="lead-text">Explore the business problem, my responsibility, and the outcome. Start with the selected cases or follow a focused path into the evidence.</p></header>
  <section class="wrap review-grid" aria-label="Review paths">
    {paths.map(path => <article class="review-card" id={path.id}><h2>{path.title}</h2><p>{path.description}</p><ul>{path.links.map(link => <li><a class="text-link" href={sitePath(link.path)}>{link.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul></article>)}
  </section>
  <section class="section-space wrap" aria-labelledby="featured-heading"><div class="section-heading-row"><div><p class="eyebrow">Selected cases</p><h2 id="featured-heading">Four perspectives on analytics delivery.</h2></div></div><div class="case-card-grid">{featuredProjects.map(project => <CaseCard project={project} />)}</div></section>
  <section class="section-space supporting-work wrap" aria-labelledby="more-heading"><div class="section-heading-row"><div><p class="eyebrow">More professional work</p><h2 id="more-heading">Models and shared reporting practices.</h2></div></div><div class="case-card-grid">{supportingProjects.map(project => <CaseCard project={project} />)}</div></section>
  <section class="contact-invitation wrap"><h2>Continue the conversation.</h2><p>Discuss the delivery challenges behind these cases and how they relate to your team.</p><div class="action-group"><a class="button" href={sitePath('/contact/')}>Get in touch ↗</a><a class="text-link" href="https://www.linkedin.com/in/smmcqueen/">Request my résumé on LinkedIn ↗</a></div></section>
</Base>
